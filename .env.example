APP_NAME=Laravel
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost

LOG_CHANNEL=stack

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=laravel
DB_USERNAME=root
DB_PASSWORD=

BROADCAST_DRIVER=log
CACHE_DRIVER=file
QUEUE_CONNECTION=sync
SESSION_DRIVER=file
SESSION_LIFETIME=120

REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_HOST=smtp.mailtrap.io
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_ENCRYPTION=null
MAIL_FROM_ADDRESS=null
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=

PROJECT_REPORT_STORAGE_DISK=public
PROJECT_REPORT_STORAGE_PATH=project_reports/files
PROJECT_REPORT_MAX_UPLOAD_KB=51200

PROJECT_REPORT_FTP_HOST=
PROJECT_REPORT_FTP_USERNAME=
PROJECT_REPORT_FTP_PASSWORD=
PROJECT_REPORT_FTP_PORT=21
PROJECT_REPORT_FTP_ROOT=/
PROJECT_REPORT_FTP_PASSIVE=true
PROJECT_REPORT_FTP_SSL=false
PROJECT_REPORT_FTP_TIMEOUT=30

PROJECT_REPORT_SFTP_HOST=
PROJECT_REPORT_SFTP_USERNAME=
PROJECT_REPORT_SFTP_PASSWORD=
PROJECT_REPORT_SFTP_PORT=22
PROJECT_REPORT_SFTP_ROOT=/
PROJECT_REPORT_SFTP_TIMEOUT=30

PUSHER_APP_ID=
PUSHER_APP_KEY=
PUSHER_APP_SECRET=
PUSHER_APP_CLUSTER=mt1

MIX_PUSHER_APP_KEY="${PUSHER_APP_KEY}"
MIX_PUSHER_APP_CLUSTER="${PUSHER_APP_CLUSTER}"
